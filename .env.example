# ──────────────────────────────────────────────────────────────
# Fyneo Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
NODE_ENV=production
# Port the NestJS server listens on (default: 4000)
PORT=4000

# ── PostgreSQL ────────────────────────────────────────────────
# When running via docker-compose, DB_HOST should be the service name (e.g. "db")
# When running locally, use "localhost"
DB_HOST=db
# Internal PostgreSQL port (always 5432 inside the container)
DB_PORT=5432
DB_USER=fyneo
DB_PASS=change_me_in_production
DB_NAME=fyneo

# ── JWT ───────────────────────────────────────────────────────
# Use a long, random, secret string — at least 64 chars recommended
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_very_long_random_secret_string_at_least_64_chars

# JWT access token expiry (parsed by @nestjs/jwt — e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=15m

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Defaults defined in main.ts: http://localhost:3000, http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
